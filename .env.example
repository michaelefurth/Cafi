# CAFI website environment variables.
# Copy to .env.local for development; set in Vercel Project Settings for production.

# Resend API key. Get one at https://resend.com/api-keys
# If unset, the contact form silently accepts submissions and logs them server-side.
RESEND_API_KEY=

# Address that receives contact form submissions.
CONTACT_TO_EMAIL=contact@cafi-usa.com

# Sender identity. Domain MUST be verified in Resend.
CONTACT_FROM_EMAIL="CAFI Website <noreply@cafi-usa.com>"
